[importlinter]
root_packages =
    peripheral_controller
    peripherals_ui
    peripheral_protocol_controls
    device_viewer
    dropbot_controller
    dropbot_preferences_ui
    dropbot_protocol_controls
    dropbot_status_and_controls
    dropbot_tools_menu
    electrode_controller
    logger
    manual_controls
    message_router
    microdrop_application
    microdrop_status_bar
    microdrop_style
    microdrop_utils
    peripheral_device_controller_base
    pluggable_protocol_tree
    plugin_management
    template_status_and_controls

[importlinter:contract:no-microdrop-plugin-internals]
name = Only consts may be imported from Microdrop plugins
type = forbidden
source_modules =
    peripheral_controller
    peripherals_ui
    peripheral_protocol_controls
forbidden_modules =
    device_viewer
    dropbot_controller
    dropbot_preferences_ui
    dropbot_protocol_controls
    dropbot_status_and_controls
    dropbot_tools_menu
    electrode_controller
    manual_controls
    microdrop_application
    microdrop_status_bar
    plugin_management
ignore_imports =
    ** -> *.consts
    ** -> microdrop_application.helpers
    ** -> microdrop_application.dialogs.**
    # --- seeded debt: existing violations, may only shrink ---
    # demo harness reaches into the shared pluggable_protocol_tree demo
    # window, which itself imports microdrop_application.menus
    # (Advanced Mode gate) inside its status controller. The violation is
    # in the shared demo helper, not in this plugin's own code.
    peripheral_protocol_controls.demos.run_widget_magnet_demo -> pluggable_protocol_tree.demos.base_demo_window

[importlinter:contract:plugin-layers]
name = UI and protocol-controls sit above the backend and stay independent
type = layers
layers =
    peripherals_ui | peripheral_protocol_controls
    peripheral_controller
ignore_imports =
    # --- seeded debt: existing violations, may only shrink ---
